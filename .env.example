# Secret de chiffrement Payload (cookies, jetons). Requis en dev.
# En prod il peut être absent : un secret aléatoire est alors généré au 1er
# démarrage et gardé dans PAYLOAD_SECRET_FILE (défaut Dockerfile : /data/.payload-secret).
PAYLOAD_SECRET=
# Base SQLite. Dev : file:./data/stratetic.db — Prod (défaut Dockerfile) : file:/data/stratetic.db
DATABASE_URI=file:./data/stratetic.db
# Dossier des médias envoyés via l'admin. Dev : ./data/media — Prod (défaut Dockerfile) : /data/media
MEDIA_DIR=
# URL publique du site (CORS / CSRF de l'admin)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Premier administrateur, créé au démarrage si aucun compte n'existe.
# Sans mot de passe, un mot de passe provisoire est généré et affiché une fois dans les logs.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
