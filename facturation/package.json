{
  "name": "facturation-stratetic",
  "version": "1.0.0",
  "private": true,
  "description": "Génération de factures proforma et définitives — Agence STRATETIC",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
